---
---

<section id="collections" class="section collections-section">
        <div class="container collections-layout">
          <div class="collections-copy">
            <p class="eyebrow">Curated collections</p>
            <h2>Share the right products at the right moment.</h2>
            <p>
              Select a set of products, name the collection, and share one public link.
              Customers see a focused page instead of searching through every item you sell.
            </p>
            <div class="collection-pills">
              <span>Diwali Collection</span>
              <span>Wedding Gifts</span>
              <span>Birthday Gifts</span>
              <span>Ready to Ship</span>
            </div>
            <a class="text-link green-link" href="https://app.whatscart.in/?utm_source=landing_page&amp;utm_medium=website&amp;utm_campaign=landing_cta&amp;utm_content=collections_cta">
              Build a collection in minutes <span aria-hidden="true">→</span>
            </a>
          </div>

          <div class="collection-demo" aria-label="Illustration of building and sharing a WhatsCart collection">
            <div class="collection-editor">
              <div class="demo-heading"><strong>Select products</strong><small>3 selected</small></div>
              <div class="collection-item"><span class="demo-thumb thumb-rose">✿</span><b>Crochet Rose Pot</b><i>✓</i></div>
              <div class="collection-item"><span class="demo-thumb thumb-gift">⌁</span><b>Wedding Gift Set</b><i>✓</i></div>
              <div class="collection-item"><span class="demo-thumb thumb-key">◉</span><b>Handmade Keychain</b><i>✓</i></div>
              <button type="button" tabindex="-1">Create collection link</button>
            </div>
            <span class="demo-connector" aria-hidden="true">→</span>
            <div class="collection-public">
              <small>PUBLIC COLLECTION</small>
              <strong>Wedding Gifts</strong>
              <div class="public-products"><i></i><i></i><i></i></div>
              <code>loops-by-ak.whatscart.in/catalog/...</code>
              <span>Ready to share ↗</span>
            </div>
          </div>
        </div>
      </section>
