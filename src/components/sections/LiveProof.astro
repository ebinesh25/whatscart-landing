---
---

<section class="section live-proof-section">
        <div class="container live-proof-layout">
          <div class="live-proof-content">
            <p class="eyebrow">See WhatsCart in the wild</p>
            <h2>Loops_by_ak is already live.</h2>
            <p>
              Browse a real WhatsCart store with searchable products, categories, cart,
              rich product pages, and a direct maker connection.
            </p>
            <a
              class="button button-large"
              href="https://loops-by-ak.whatscart.in/"
              target="_blank"
              rel="noreferrer"
            >Open the live store <span aria-hidden="true">↗</span></a>
          </div>
          <a
            class="live-proof-image"
            href="https://loops-by-ak.whatscart.in/"
            target="_blank"
            rel="noreferrer"
            aria-label="Open the live Loops_by_ak store"
          >
            <picture>
              <source
                type="image/webp"
                srcset="/assets/loops-by-ak-storefront.webp"
              />
              <img
                src="/assets/loops-by-ak-storefront.png"
                alt="Screenshot of the live Loops_by_ak WhatsCart store"
                width="1440"
                height="900"
                loading="lazy"
              />
            </picture>
            <span>Click to explore the live store ↗</span>
          </a>
        </div>
      </section>
