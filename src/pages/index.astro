  gap: 8px;
  padding: 13px;
  border: 1px solid #dce8da;
  border-radius: 13px;
  background: #f8fbf7;
  transform: rotate(-2deg);
}

.site-mini-ui span {
  grid-column: 1 / -1;
  padding: 7px 9px;
  border-radius: 7px;
  color: #819086;
  background: var(--white);
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 8px;
}

.site-mini-ui i {
  height: 80px;
  border-radius: 8px;
  background: #cfe5c9;
}

.site-mini-ui i:nth-of-type(2) {
  background: #ead0b5;
}

.site-mini-ui i:nth-of-type(3) {
  background: #ccd3e7;
}

.code-mini-ui {
  display: grid;
  gap: 8px;
  padding: 17px;
  border: 1px solid #314734;
  border-radius: 13px;
  background: #111a13;
}

.code-mini-ui code {
  color: #82a987;
  font-size: 9px;
  white-space: normal;
}

.code-mini-ui code:nth-child(2) {
  padding-left: 13px;
  color: #d6e4d7;
}

.analytics-mini-ui {
  display: grid;
  gap: 9px;
}

.analytics-mini-ui > div {
  padding: 13px;
  border: 1px solid #dce8da;
  border-radius: 12px;
  background: #f8fbf7;
}

.analytics-mini-ui small,
.analytics-mini-ui strong {
  display: block;
}

.analytics-mini-ui small {
  color: #829087;
  font-size: 8px;
  font-weight: 800;
  letter-spacing: 0.07em;
  text-transform: uppercase;
}

.analytics-mini-ui strong {
  margin-top: 3px;
  font-size: 24px;
}

.source-bars {
  display: grid;
  gap: 5px;
  margin-top: 10px;
}

.source-bars i {
  display: block;
  width: 86%;
  height: 6px;
  border-radius: 99px;
  background: var(--green);
}

.source-bars i:nth-child(2) {
  width: 58%;
  background: #e35c78;
}

.source-bars i:nth-child(3) {
  width: 35%;
  background: #477cca;
}

.collections-layout {
  display: grid;
  grid-template-columns: 0.85fr 1.15fr;
  align-items: center;
  gap: 84px;
}

.collections-copy h2 {
  max-width: 530px;
}

.collection-pills {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 27px;
}

.collection-pills span {
  padding: 8px 12px;
  border: 1px solid var(--line);
  border-radius: 999px;
  color: #56685c;
  background: #fbfdfb;
  font-size: 10px;
  font-weight: 800;
}

.collection-demo {
  display: grid;
  grid-template-columns: 1fr 42px 0.9fr;
  align-items: center;
  min-height: 440px;
  padding: 30px;
  border-radius: 29px;
  background: #e9f3e7;
}

.collection-editor,
.collection-public {
  padding: 20px;
  border: 1px solid #dbe7d9;
  border-radius: 18px;
  background: var(--white);
  box-shadow: 0 14px 30px rgba(43, 78, 45, 0.1);
}

.demo-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 13px;
}

.demo-heading strong {
  font-size: 14px;
}

.demo-heading small {
  color: var(--green);
  font-size: 9px;
  font-weight: 900;
}

.collection-item {
  display: grid;
  grid-template-columns: 42px 1fr 22px;
  align-items: center;
  gap: 10px;
  margin-top: 8px;
  padding: 8px;
  border: 1px solid #dfebdd;
  border-radius: 10px;
  background: #fbfdfb;
}

.collection-item b {
  font-size: 10px;
}

.collection-item i {
  display: grid;
  place-items: center;
  width: 19px;
  height: 19px;
  border-radius: 50%;
  color: var(--white);
  background: var(--green);
  font-size: 9px;
  font-style: normal;
}

.demo-thumb {
  display: grid;
  place-items: center;
  width: 42px;
  height: 42px;
  border-radius: 8px;
  color: var(--white);
  font-size: 20px;
}

.thumb-rose {
  background: #cf5c60;
}

.thumb-gift {
  background: #d8aa72;
}

.thumb-key {
  background: #718eae;
}

.collection-editor button {
  width: 100%;
  margin-top: 14px;
  padding: 11px;
  border: 0;
  border-radius: 9px;
  color: var(--white);
  background: var(--ink);
  font-size: 10px;
  font-weight: 900;
  pointer-events: none;
}

.demo-connector {
  color: var(--green);
  font-size: 30px;
  text-align: center;
}

.collection-public {
  transform: rotate(2deg);
}

.collection-public > small,
.collection-public > strong,
.collection-public > code,
.collection-public > span {
  display: block;
}

.collection-public > small {
  color: var(--green);
  font-size: 8px;
  font-weight: 900;
  letter-spacing: 0.1em;
}

.collection-public > strong {
  margin-top: 6px;
  font-size: 18px;
}

.public-products {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 6px;
  margin: 14px 0;
}

.public-products i {
  height: 82px;
  border-radius: 8px;
  background: #c7dfbd;
}

.public-products i:nth-child(2) {
  background: #e7c5a6;
}

.public-products i:nth-child(3) {
  background: #c2c9de;
}

.collection-public > code {
  overflow: hidden;
  padding: 7px;
  border-radius: 7px;
  color: #718077;
  background: #f4f7f3;
  font-size: 7px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.collection-public > span {
  margin-top: 12px;
  color: var(--green);
  font-size: 9px;
  font-weight: 900;
  text-align: right;
}

.comparison-section {
  background: #fbfdfb;
}

.comparison-wrap {
  overflow: hidden;
  border: 1px solid var(--line);
  border-radius: 24px;
  background: var(--white);
}

.comparison-wrap table {
  width: 100%;
  border-collapse: collapse;
  table-layout: fixed;
}

.comparison-wrap th,
.comparison-wrap td {
  padding: 18px 16px;
  border-bottom: 1px solid #e8eee7;
  vertical-align: top;
  font-size: 12px;
  line-height: 1.55;
}

.comparison-wrap thead th {
  padding-top: 23px;
  padding-bottom: 23px;
  color: #66776b;
  font-size: 10px;
  font-weight: 900;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.comparison-wrap th:first-child {
  width: 22%;
}

.comparison-wrap tbody th {
  color: #35463a;
  font-weight: 800;
  text-align: left;
}

.comparison-wrap tbody td {
  color: #68796e;
}

.comparison-wrap tr:last-child th,
.comparison-wrap tr:last-child td {
  border-bottom: 0;
}

.comparison-wrap .featured-column {
  color: #2d5c31;
  background: #f0f8ee;
}

.comparison-wrap thead .featured-column {
  position: relative;
  padding-top: 38px;
  color: var(--green-dark);
}

.comparison-wrap thead .featured-column span {
  position: absolute;
  top: 8px;
  right: 12px;
  left: 12px;
  padding: 5px 7px;
  border-radius: 99px;
  color: var(--white);
  background: var(--green);
  font-size: 7px;
  text-align: center;
}

.comparison-note {
  max-width: 900px;
  margin: 18px auto 0;
  color: #7d8c82;
  font-size: 10px;
  line-height: 1.7;
  text-align: center;
}

.comparison-note a {
  color: var(--green-dark);
  font-weight: 800;
  text-decoration: underline;
  text-underline-offset: 3px;
}

.steps-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 13px;
  margin: 0;
  padding: 0;
  list-style: none;
}

.steps-grid li {
  position: relative;
  min-height: 190px;
  padding: 22px 18px;
  border: 1px solid var(--line);
  border-radius: 18px;
  background: var(--white);
}

.steps-grid li:last-child {
  border-color: var(--green);
  box-shadow: 0 14px 30px rgba(58, 170, 52, 0.11);
}

.steps-grid span {
  display: grid;
  place-items: center;
  width: 38px;
  height: 38px;
  margin-bottom: 30px;
  border-radius: 12px;
  color: var(--green);
  background: #eaf5e8;
  font-size: 10px;
  font-weight: 900;
}

.steps-grid h3 {
  margin: 0 0 8px;
  font-size: 15px;
  line-height: 1.25;
}

.steps-grid p {
  margin: 0;
  color: #748277;
  font-size: 11px;
  line-height: 1.55;
}

.live-proof-section {
  border-bottom: 1px solid var(--line);
}

.live-proof-layout {
  display: grid;
  grid-template-columns: 0.75fr 1.25fr;
  align-items: center;
  gap: 78px;
}

.live-proof-layout .button {
  margin-top: 28px;
}

.live-proof-image {
  position: relative;
  display: block;
  overflow: hidden;
  border: 1px solid #d8e5d6;
  border-radius: 24px;
  background: #fbfaf8;
  box-shadow: 20px 28px 60px rgba(38, 73, 40, 0.13);
}

.live-proof-image img {
  width: 100%;
  aspect-ratio: 16 / 9.7;
  object-fit: cover;
  object-position: top center;
  transition: transform 0.45s ease;
}

.live-proof-image:hover img {
  transform: scale(1.015);
}

.live-proof-image span {
  position: absolute;
  right: 14px;
  bottom: 14px;
  padding: 9px 12px;
  border-radius: 999px;
  color: var(--white);
  background: rgba(22, 32, 24, 0.9);
  font-size: 9px;
  font-weight: 900;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.pricing-layout {
  display: grid;
  grid-template-columns: 1fr 430px;
  align-items: center;
  gap: 100px;
}

.pricing-copy h2 {
  margin: 0;
  font-size: clamp(42px, 5vw, 64px);
  font-weight: 850;
  line-height: 1.02;
  letter-spacing: -0.07em;
}

.pricing-copy > p:not(.eyebrow) {
  max-width: 470px;
  margin: 25px 0;
  color: #748177;
  font-size: 18px;
  line-height: 1.65;
}

.pricing-note {
  display: flex;
  align-items: center;
  gap: 14px;
  max-width: 345px;
  padding: 17px;
  border: 1px solid var(--line);
  border-radius: 14px;
  background: var(--soft);
}

.pricing-note > span {
  display: grid;
  place-items: center;
  flex: 0 0 auto;
  width: 30px;
  height: 30px;
  border-radius: 50%;
  color: var(--green);
  background: #dff0dc;
  font-weight: 900;
}

.pricing-note p {
  margin: 0;
  color: #708072;
  font-size: 12px;
}

.pricing-note strong {
  color: var(--ink);
  font-size: 13px;
}

.price-card {
  position: relative;
  padding: 37px 36px 30px;
  border: 2px solid var(--green);
  border-radius: 30px;
  background: var(--white);
  box-shadow: 0 20px 60px rgba(45, 123, 41, 0.13);
  text-align: center;
}

.offer-ribbon {
  position: absolute;
  top: 0;
  right: 0;
  padding: 9px 20px;
  border-radius: 0 27px 0 20px;
  color: var(--white);
  background: var(--green);
  font-size: 9px;
  font-weight: 900;
  letter-spacing: 0.1em;
}

.price-label {
  margin: 8px 0;
  color: #738074;
  font-size: 13px;
  font-weight: 700;
}

.price {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 6px;
  margin: 3px 0 16px;
}

.price strong {
  font-size: 64px;
  letter-spacing: -0.08em;
}

.price span {
  color: #8b9a8e;
  font-size: 14px;
}

.free-pill {
  display: inline-block;
  padding: 8px 15px;
  border-radius: 999px;
  color: var(--green-dark);
  background: #e4f5e1;
  font-size: 10px;
  font-weight: 900;
  letter-spacing: 0.08em;
}

.price-card ul {
  display: grid;
  gap: 13px;
  margin: 27px 0;
  padding: 0;
  color: #506052;
  font-size: 13px;
  text-align: left;
  list-style: none;
}

.price-card li::first-letter {
  color: var(--green);
}

.price-card > small {
  display: block;
  margin-top: 14px;
  color: #8a988e;
  font-size: 11px;
}

.faq-section {
  background: #fbfdfb;
}

.faq-layout {
  display: grid;
  grid-template-columns: 0.78fr 1.22fr;
  gap: 90px;
}

.faq-list {
  display: grid;
  gap: 10px;
}

.faq-list details {
  padding: 18px 21px;
  border: 1px solid var(--line);
  border-radius: 14px;
  background: var(--white);
}

.faq-list details[open] {
  border-color: #c8dfc5;
  box-shadow: 0 10px 25px rgba(43, 78, 45, 0.05);
}

.faq-list summary {
  cursor: pointer;
  font-size: 15px;
  font-weight: 800;
  list-style: none;
}

.faq-list summary::-webkit-details-marker {
  display: none;
}

.faq-list summary::after {
  float: right;
  margin-left: 16px;
  color: var(--green);
  content: "+";
  font-size: 20px;
  line-height: 1;
}

.faq-list details[open] summary::after {
  content: "−";
}

.faq-list p {
  max-width: 650px;
  margin: 12px 0 0;
  color: #748177;
  font-size: 13px;
  line-height: 1.7;
}

.faq-list p strong {
  color: #53635a;
}

.final-cta {
  position: relative;
  overflow: hidden;
  padding: 116px 0;
  color: var(--white);
  background: var(--green);
}

.final-inner {
  position: relative;
  text-align: center;
}

.final-cta .eyebrow {
  color: #d9f3d4;
}

.final-cta h2 {
  position: relative;
  margin: 0;
  font-size: clamp(42px, 5vw, 67px);
  font-weight: 850;
  line-height: 1.02;
  letter-spacing: -0.07em;
}

.final-cta h2 span {
  color: #d5f1d1;
}

.final-cta > div > p:not(.eyebrow) {
  position: relative;
  margin: 22px 0 30px;
  color: #d9f3d4;
  font-size: 18px;
}

.final-actions {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24px;
}

.final-actions > a:last-child {
  color: var(--white);
  font-size: 14px;
  font-weight: 800;
  text-decoration: underline;
  text-decoration-color: rgba(255, 255, 255, 0.5);
  text-underline-offset: 5px;
}

.cta-orbit {
  position: absolute;
  width: 220px;
  height: 220px;
  border: 1px solid rgba(255, 255, 255, 0.25);
  border-radius: 50%;
}

.orbit-one {
  top: -60px;
  left: 2%;
}

.orbit-two {
  right: 5%;
  bottom: -80px;
  width: 300px;
  height: 300px;
}

.site-footer {
  color: #9cae9f;
  background: var(--dark);
}

.footer-inner {
  display: grid;
  grid-template-columns: 1.15fr 1.35fr auto;
  align-items: center;
  gap: 25px;
  padding: 40px 0;
}

.footer-brand {
  color: var(--white);
  font-size: 18px;
}

.footer-inner p {
  margin: 0;
  font-size: 12px;
}

.footer-inner > div {
  display: flex;
  gap: 18px;
  color: #dae8da;
  font-size: 11px;
  font-weight: 700;
}

.footer-inner > div a:hover {
  color: #91da8b;
}

.footer-inner small {
  grid-column: 1 / -1;
  padding-top: 20px;
  border-top: 1px solid #2b3b2d;
  color: #809281;
  font-size: 11px;
}

@media (max-width: 1100px) {
  .nav-links {
    gap: 18px;
  }

  .transformation-map {
    grid-template-columns: minmax(190px, 1fr) 46px minmax(200px, 0.9fr) 46px minmax(210px, 1fr);
    gap: 10px;
    padding: 24px;
  }

  .source-card,
  .outcome-card {
    padding: 9px;
  }

  .proof-grid > div {
    padding: 0 18px;
  }

  .growth-card {
    padding: 24px;
  }
}

@media (max-width: 920px) {
  .nav-links {
    display: none;
  }

  .hero-grid,
  .growth-intro,
  .collections-layout,
  .live-proof-layout,
  .pricing-layout,
  .faq-layout {
    grid-template-columns: 1fr;
    gap: 52px;
  }

  .hero-copy,
  .pricing-copy {
    text-align: center;
  }

  .hero-copy .eyebrow,
  .hero-actions {
    justify-content: center;
  }

  .hero-lede,
  .pricing-copy > p:not(.eyebrow),
  .pricing-note {
    margin-right: auto;
    margin-left: auto;
  }

  .hero-visual {
    max-width: 650px;
    margin: 0 auto;
  }

  .proof-grid {
    grid-template-columns: repeat(3, 1fr);
    padding: 20px 0;
  }

  .proof-grid p {
    grid-column: 1 / -1;
    margin-top: 20px;
    padding: 20px 0 0;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    border-left: 0;
    text-align: center;
  }

  .transformation-map {
    grid-template-columns: 1fr;
    max-width: 620px;
    margin: 0 auto;
    gap: 15px;
  }

  .flow-arrow {
    flex-direction: row;
    justify-content: center;
    transform: none;
  }

  .flow-arrow::after {
    content: "↓";
  }

  .flow-arrow {
    font-size: 0;
  }

  .flow-arrow span {
    font-size: 8px;
  }

  .flow-arrow::after {
    font-size: 24px;
  }

  .store-hub-card {
    max-width: 360px;
    margin: 0 auto;
  }

  .growth-intro {
    align-items: start;
    gap: 24px;
  }

  .growth-intro > p {
    max-width: 650px;
  }

  .growth-grid {
    grid-template-columns: 1fr;
    max-width: 690px;
    margin: 0 auto;
  }

  .growth-card {
    min-height: 390px;
  }

  .collections-copy,
  .live-proof-layout > div {
    max-width: 650px;
    text-align: center;
    margin: 0 auto;
  }

  .collections-copy .eyebrow,
  .collection-pills {
    justify-content: center;
  }

  .collections-copy > p,
  .live-proof-layout > div > p {
    margin-right: auto;
    margin-left: auto;
  }

  .collection-demo {
    max-width: 720px;
    margin: 0 auto;
  }

  .steps-grid {
    grid-template-columns: repeat(3, 1fr);
  }

  .live-proof-image {
    max-width: 760px;
    margin: 0 auto;
  }

  .faq-section .section-heading {
    max-width: 650px;
    margin: 0 auto;
    text-align: center;
  }

  .faq-section .section-heading > p:last-child {
    margin-right: auto;
    margin-left: auto;
  }

  .footer-inner {
    grid-template-columns: 1fr 1fr;
  }

  .footer-inner > div {
    justify-content: flex-end;
  }
}

@media (max-width: 680px) {
  .container {
    width: min(100% - 32px, 1180px);
  }

  .nav {
    height: 70px;
  }

  .brand {
    font-size: 18px;
  }

  .brand-logo {
    height: 32px;
  }

  .login-link {
    display: none;
  }

  .button-small {
    min-height: 40px;
    padding: 9px 14px;
    font-size: 12px;
  }

  .hero {
    padding: 58px 0 68px;
  }

  .hero-grid {
    gap: 42px;
  }

  .hero h1 {
    font-size: 46px;
  }

  .hero-lede {
    font-size: 16px;
  }

  .hero-actions {
    display: grid;
    gap: 19px;
  }

  .hero-actions .button {
    width: 100%;
  }

  .hero-visual {
    padding: 10px 0 40px;
  }

  .floating-order {
    bottom: 4px;
    left: -8px;
  }

  .floating-growth {
    top: -12px;
    right: -8px;
  }

  .store-preview {
    padding: 16px;
  }

  .preview-banner {
    min-height: 145px;
    padding: 18px;
  }

  .preview-banner strong {
    font-size: 19px;
  }

  .banner-orb {
    width: 78px;
    height: 78px;
    font-size: 30px;
  }

  .product-row {
    gap: 7px;
  }

  .tile-art {
    height: 60px;
  }

  .product-tile strong,
  .product-tile small {
    font-size: 7px;
  }

  .proof-grid {
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
  }

  .proof-grid > div {
    padding: 0 8px;
    text-align: center;
  }

  .proof-grid strong {
    font-size: 25px;
  }

  .proof-grid span {
    font-size: 7px;
    line-height: 1.35;
  }

  .proof-grid p {
    font-size: 11px;
  }

  .section {
    padding: 78px 0;
  }

  .section-heading {
    margin-bottom: 42px;
  }

  .section-heading h2,
  .growth-intro h2,
