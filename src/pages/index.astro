---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/sections/Hero.astro';
import ProofStrip from '../components/sections/ProofStrip.astro';
import WhyWhatsCart from '../components/sections/WhyWhatsCart.astro';
import GrowthStack from '../components/sections/GrowthStack.astro';
import Collections from '../components/sections/Collections.astro';
import Comparison from '../components/sections/Comparison.astro';
import HowItWorks from '../components/sections/HowItWorks.astro';
import LiveProof from '../components/sections/LiveProof.astro';
import Pricing from '../components/sections/Pricing.astro';
import Faq from '../components/sections/Faq.astro';
import FinalCta from '../components/sections/FinalCta.astro';
---

<Layout>
  <a class="skip-link" href="#main-content">Skip to main content</a>
  <Header />

  <main id="main-content">
    <Hero />
    <ProofStrip />
    <WhyWhatsCart />
    <GrowthStack />
    <Collections />
    <Comparison />
    <HowItWorks />
    <LiveProof />
    <Pricing />
    <Faq />
    <FinalCta />
  </main>

  <Footer />
</Layout>